@model BaiTapLab_2.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
    var monHocList = ViewBag.MonHocList as List<BaiTapLab_2.Models.MonHoc>;
}

<h2 class="mb-3">Thêm sinh viên</h2>

<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6">

            <div class="form-group mb-3">
                <label asp-for="StudentName" class="form-label">Tên sinh viên</label>
                <input asp-for="StudentName" class="form-control" />
                <span asp-validation-for="StudentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaSV" class="form-label">Mã sinh viên</label>
                <input asp-for="MaSV" class="form-control" />
                <span asp-validation-for="MaSV" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DOB" class="form-label">Ngày sinh</label>
                <input asp-for="DOB" type="date" class="form-control" />
                <span asp-validation-for="DOB" class="text-danger"></span>
            </div>

            <!-- Dropdown chọn Lớp -->
            <div class="form-group mb-3">
                <label class="form-label">Lớp</label>
                <select asp-for="LopId" class="form-select" asp-items="ViewBag.LopList">
                    <option value="">-- Chọn lớp --</option>
                </select>
                <span asp-validation-for="LopId" class="text-danger"></span>
            </div>

        </div>

        <!-- Cột phải: danh sách môn học -->
        <div class="col-md-6">

            <div class="form-group mb-2">
                <label class="form-label">Môn học đăng ký</label><br />

                @if (monHocList != null)
                {
                    foreach (var mh in monHocList)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="selectedMonHocIds"
                                   value="@mh.Id" />

                            <label class="form-check-label">
                                @mh.TenMon (@mh.MaMon)
                            </label>
                        </div>
                    }
                }
                else
                {
                    <p class="text-danger">Không có môn học nào!</p>
                }

            </div>

        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
